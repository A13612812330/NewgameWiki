# Main service
SERVE_WEB=1
PORT=64111
HOST=127.0.0.1

# Scheduler
SCHEDULER_CHECK_MS=60000
SCHEDULER_TIMEOUT_MS=300000
SCHEDULER_INITIAL_DELAY_MS=120000

# Crawler limits and cache. Use a folder on the project drive, not the system temp disk.
NEWWIKI_BROWSER_CACHE_DIR=./runtime-cache/browser/taptap
NEWWIKI_CRAWL_FETCH_TIMEOUT_MS=15000
NEWWIKI_TAPTAP_DETAIL_LIMIT=24
NEWWIKI_TAPTAP_RENDERED_DETAIL_LIMIT=24
NEWWIKI_XIAOQI_STATIC_TARGET_ROWS=40
NEWWIKI_WRITE_CRAWL_CACHE=0

# SQLite retention
NEWWIKI_MAX_DAILY_SNAPSHOTS=30
NEWWIKI_MAX_RECORD_HISTORY=2000

# Local backup retention. Backups are retained by default; set to 1 only when automatic pruning is desired.
NEWWIKI_PRUNE_BACKUPS=0
NEWWIKI_MAX_UNDO_SNAPSHOTS=10
NEWWIKI_MAX_BACKUP_PAIRS=10

# Optional. Do not add a real service key to version control.
# NEWWIKI_FIRECRAWL_FALLBACK=0
# FIRECRAWL_API_KEY=
# FIRECRAWL_API_BASE_URL=https://api.firecrawl.dev/v2
